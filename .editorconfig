root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

[*.cshtml]
indent_style = space
indent_size = 4
tab_width = 4

[*.{json,xml,csproj,props,targets}]
indent_style = space
indent_size = 2