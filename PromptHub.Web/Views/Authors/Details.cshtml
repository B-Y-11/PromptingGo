@using PromptHub.Web.Extensions
@model PromptHub.Web.Models.ViewModels.Authors.AuthorProfileViewModel

@{
    ViewData["Title"] = Model.DisplayName;

    if (Model.PublishedPromptsCount > 0)
    {
        ViewData["Title"] =
            $"{Model.DisplayName} — автор промптов";

        ViewData["MetaDescription"] =
    $"Промпты автора {Model.DisplayName} на PromptingGo. Опубликовано промптов: {Model.PublishedPromptsCount}." +
    (
        string.IsNullOrWhiteSpace(
            Model.Bio)
            ? string.Empty
            : $" {Model.Bio}"
    );

        ViewData["Robots"] =
            "index,follow";

        ViewData["CanonicalUrl"] =
            Url.Action(
                "Details",
                "Authors",
                new
                {
                    id =
                        Model.AuthorId
                },
                protocol:
                    Context.Request.Scheme,
                host:
                    Context.Request.Host.Value);

        ViewData["OgType"] =
            "profile";

        var homeUrl =
    Url.Action(
        "Index",
        "Home",
        values: null,
        protocol:
            Context.Request.Scheme,
        host:
            Context.Request.Host.Value);

        var authorUrl =
            ViewData["CanonicalUrl"]
                ?.ToString();

        var person =
            new Dictionary<string, object?>
            {
                ["@type"] =
                    "Person",

                ["@id"] =
                    $"{authorUrl}#author",

                ["name"] =
                    Model.DisplayName,

                ["identifier"] =
                    Model.AuthorId,

                ["url"] =
                    authorUrl
            };

        if (!string.IsNullOrWhiteSpace(
                Model.Bio))
        {
            person["description"] =
                Model.Bio;
        }

        var profilePage =
            new Dictionary<string, object?>
            {
                ["@type"] =
                    "ProfilePage",

                ["@id"] =
                    $"{authorUrl}#webpage",

                ["url"] =
                    authorUrl,

                ["name"] =
                    $"{Model.DisplayName} — автор промптов",

                ["mainEntity"] =
                    new Dictionary<string, object?>
                    {
                        ["@id"] =
                            $"{authorUrl}#author"
                    }
            };

        var breadcrumbs =
            new Dictionary<string, object?>
            {
                ["@type"] =
                    "BreadcrumbList",

                ["@id"] =
                    $"{authorUrl}#breadcrumb",

                ["itemListElement"] =
                    new object[]
                    {
                new Dictionary<string, object?>
                {
                    ["@type"] =
                        "ListItem",

                    ["position"] =
                        1,

                    ["name"] =
                        "Главная",

                    ["item"] =
                        homeUrl
                },

                new Dictionary<string, object?>
                {
                    ["@type"] =
                        "ListItem",

                    ["position"] =
                        2,

                    ["name"] =
                        Model.DisplayName,

                    ["item"] =
                        authorUrl
                }
                    }
            };

        profilePage["breadcrumb"] =
            new Dictionary<string, object?>
            {
                ["@id"] =
                    $"{authorUrl}#breadcrumb"
            };

        var jsonLd =
            new Dictionary<string, object?>
            {
                ["@context"] =
                    "https://schema.org",

                ["@graph"] =
                    new object[]
                    {
                profilePage,
                person,
                breadcrumbs
                    }
            };

        ViewData["JsonLd"] =
            JsonSerializer.Serialize(
                jsonLd);
    }

    var authorInitial =
        !string.IsNullOrWhiteSpace(Model.DisplayName)
            ? Model.DisplayName.Trim()[0]
                .ToString()
                .ToUpperInvariant()
            : "A";
}

<section class="author-profile-page">
    <header class="author-profile-header">
        <div class="author-profile-main">
            <div class="author-profile-avatar">
                <span>
                    @authorInitial
                </span>

                @if (!string.IsNullOrWhiteSpace(
                Model.AvatarContentUrl))
                {
                    <img src="@Model.AvatarContentUrl"
                         alt="@Model.DisplayName"
                         loading="lazy"
                         decoding="async" />
                }
            </div>

            <div>
                <div class="author-profile-kicker">
                    Автор PromptingGo
                </div>

                <h1 class="author-profile-title">
                    @Model.DisplayName
                </h1>

                <p class="author-profile-description">
                    @if (string.IsNullOrWhiteSpace(
                        Model.Bio))
                    {
                        <span>
                            Автор пока не добавил описание.
                        </span>
                    }
                    else
                    {
                        @Model.Bio
                    }
                </p>

                <div class="author-profile-meta">
                    <span>
                        На сайте с

                        <time datetime="@Model.CreatedAtUtc.ToUtcIsoString()"
                              data-local-date>
                            @Model.CreatedAtUtc.ToString("dd.MM.yyyy")
                        </time>
                    </span>
                </div>
            </div>
        </div>
    </header>


    @if (Model.AuthorSupport?.IsAvailable == true)
    {
        <section class="author-support-profile-card">
            <div>
                <div class="author-support-card-kicker">
                    Поддержка автора
                </div>

                <h2>
                    Нравятся работы автора?
                </h2>

                <p>
                    Если промпты @Model.DisplayName
                    оказались полезными,
                    можно добровольно поддержать автора.
                </p>
            </div>

            <button type="button"
                    class="btn btn-outline-primary"
                    data-author-support-open>
                Поддержать
            </button>
        </section>

        <partial name="_AuthorSupportDialog"
                 model="Model.AuthorSupport" />
    }


    <div class="author-profile-stats">
        <div class="author-profile-stat">
            <div class="author-profile-stat-label">
                Опубликовано
            </div>

            <div class="author-profile-stat-value">
                @Model.PublishedPromptsCount
            </div>
        </div>

        <div class="author-profile-stat">
            <div class="author-profile-stat-label">
                Просмотры
            </div>

            <div class="author-profile-stat-value">
                @Model.TotalViewCount
            </div>
        </div>

        <div class="author-profile-stat">
            <div class="author-profile-stat-label">
                Копирования
            </div>

            <div class="author-profile-stat-value">
                @Model.TotalCopyCount
            </div>
        </div>

        <div class="author-profile-stat">
            <div class="author-profile-stat-label">
                Средняя оценка
            </div>

            <div class="author-profile-stat-value">
                @(Model.RatingCount > 0
                    ? Model.AverageRating.ToString("0.0")
                    : "—")
            </div>
        </div>
    </div>

    <section class="author-profile-prompts">
        <header class="home-section-header">
            <div>
                <div class="notebook-page-kicker">
                    Публикации автора
                </div>

                <h2>
                    Опубликованные промпты
                </h2>

                <p>
                    Все материалы автора,
                    доступные в общем каталоге.
                </p>
            </div>
        </header>

        @if (Model.Prompts.Count == 0)
        {
            <div class="notebook-empty-state">
                <h2>
                    Публикаций пока нет
                </h2>

                <p class="text-muted">
                    У автора ещё нет опубликованных промптов.
                </p>

                <a asp-controller="Prompts"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Перейти в каталог
                </a>
            </div>
        }
        else
        {
            <svg class="catalog-icon-sprite"
                 aria-hidden="true"
                 focusable="false">
                <symbol id="catalog-icon-eye"
                        viewBox="0 0 24 24">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                    <circle cx="12"
                            cy="12"
                            r="2.6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8" />
                </symbol>

                <symbol id="catalog-icon-copy"
                        viewBox="0 0 24 24">
                    <rect x="8"
                          y="8"
                          width="11"
                          height="11"
                          rx="2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8" />
                    <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </symbol>

                <symbol id="catalog-icon-comment"
                        viewBox="0 0 24 24">
                    <path d="M5 5.5h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-8l-5 3v-3H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round" />
                </symbol>
            </svg>

            <div class="prompt-notes-grid">
                @foreach (var prompt in Model.Prompts)
                {
                    var coverImageUrl =
                        prompt.Cover is null
                            ? null
                            : Url.RouteUrl(
                                "PromptMediaThumbnail",
                                new
                                {
                                    id = prompt.Cover.MediaId
                                });

                    var coverAltText =
                        prompt.Cover is null ||
                        string.IsNullOrWhiteSpace(
                            prompt.Cover.AltText)
                            ? $"Обложка промпта «{prompt.Title}»"
                            : prompt.Cover.AltText;

                    var visibleTags =
                        prompt.Tags
                            .Take(2)
                            .ToList();

                    var hiddenTagCount =
                        Math.Max(
                            0,
                            prompt.Tags.Count - visibleTags.Count);

                    <article class="prompt-note-card catalog-prompt-card">
                        <div class="prompt-note-tape">
                        </div>

                        <a asp-controller="Prompts"
                           asp-action="Details"
                           asp-route-slug="@prompt.Slug"
                           class="prompt-card-cover
                            @(prompt.Cover is null
                               ? "is-placeholder"
                               : string.Empty)"
                           aria-label="Открыть промпт «@prompt.Title»">

                            @if (coverImageUrl is not null)
                            {
                                <img src="@coverImageUrl"
                                     alt="@coverAltText"
                                     class="prompt-card-cover-image"
                                     loading="lazy"
                                     decoding="async" />
                            }
                            else
                            {
                                <span class="prompt-card-cover-placeholder">
                                    <span class="prompt-card-cover-placeholder-mark"
                                          aria-hidden="true">
                                        PH
                                    </span>

                                    <span class="prompt-card-cover-placeholder-category">
                                        @prompt.CategoryName
                                    </span>

                                    <span class="prompt-card-cover-placeholder-text">
                                        Пример результата пока не добавлен
                                    </span>
                                </span>
                            }
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form action="@Url.Action(
                                                                "ToggleFavorite",
                                                                "Prompts",
                                                                new
                                                                {
                                                                    slug = prompt.Slug
                                                                })"
                                  method="post"
                                  class="favorite-toggle-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm favorite-toggle-button
                                    @(prompt.IsFavorite
                                        ? "btn-primary is-favorite"
                                        : "btn-outline-primary")"
                                        aria-pressed="@prompt.IsFavorite.ToString().ToLowerInvariant()"
                                        data-add-label="В избранное"
                                        data-remove-label="В избранном">
                                    @(prompt.IsFavorite
                                        ? "В избранном"
                                        : "В избранное")
                                </button>
                            </form>
                        }

                        <div class="prompt-card-badge-zone">
                            <div class="prompt-note-tags">
                                <span class="notebook-tag notebook-tag-purple">
                                    @prompt.CategoryName
                                </span>

                                <span class="notebook-tag">
                                    @prompt.DifficultyName
                                </span>

                                @if (prompt.HasConstructor)
                                {
                                    <span class="notebook-tag notebook-tag-blue">
                                        Есть настройка
                                    </span>
                                }
                            </div>

                            @if (visibleTags.Count > 0)
                            {
                                <div class="prompt-note-extra-tags">
                                    @foreach (var tag in visibleTags)
                                    {
                                        <span class="prompt-tag-badge">
                                            #@tag.Name
                                        </span>
                                    }

                                    @if (hiddenTagCount > 0)
                                    {
                                        <span class="prompt-tag-badge catalog-tag-more"
                                              title="Ещё тегов: @hiddenTagCount">
                                            +@hiddenTagCount
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        <h2 class="prompt-note-title">
                            <a asp-controller="Prompts"
                               asp-action="Details"
                               asp-route-slug="@prompt.Slug">
                                @prompt.Title
                            </a>
                        </h2>

                        <p class="prompt-note-summary">
                            @prompt.Summary
                        </p>

                        <div class="catalog-card-info">
                            <div class="catalog-card-rating"
                                 title="@(prompt.RatingCount > 0
                                                                    ? $"Средняя оценка {prompt.AverageRating:0.0} из 5, голосов: {prompt.RatingCount}"
                                                                    : "Оценок пока нет")">
                                <span class="catalog-card-rating-star"
                                      aria-hidden="true">
                                    @(prompt.RatingCount > 0 ? "★" : "☆")
                                </span>

                                @if (prompt.RatingCount > 0)
                                {
                                    <span>
                                        @prompt.AverageRating.ToString("0.0")
                                    </span>

                                    <span class="catalog-card-rating-count">
                                        (@prompt.RatingCount)
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Нет оценок
                                    </span>
                                }

                                @if (prompt.CurrentUserRating.HasValue)
                                {
                                    <span class="prompt-note-user-rating">
                                        Ваша: @prompt.CurrentUserRating
                                    </span>
                                }
                            </div>

                            <div class="catalog-card-metrics"
                                 aria-label="Статистика промпта">
                                <span class="catalog-card-metric"
                                      title="Просмотры: @prompt.ViewCount">
                                    <svg class="catalog-card-metric-icon"
                                         aria-hidden="true"
                                         focusable="false">
                                        <use href="#catalog-icon-eye"></use>
                                    </svg>
                                    <span class="visually-hidden">
                                        Просмотры:
                                    </span>
                                    <span>
                                        @prompt.ViewCount
                                    </span>
                                </span>

                                <span class="catalog-card-metric"
                                      title="Копирования: @prompt.CopyCount">
                                    <svg class="catalog-card-metric-icon"
                                         aria-hidden="true"
                                         focusable="false">
                                        <use href="#catalog-icon-copy"></use>
                                    </svg>
                                    <span class="visually-hidden">
                                        Копирования:
                                    </span>
                                    <span>
                                        @prompt.CopyCount
                                    </span>
                                </span>

                                <span class="catalog-card-metric"
                                      title="Комментарии: @prompt.VisibleCommentCount">
                                    <svg class="catalog-card-metric-icon"
                                         aria-hidden="true"
                                         focusable="false">
                                        <use href="#catalog-icon-comment"></use>
                                    </svg>
                                    <span class="visually-hidden">
                                        Комментарии:
                                    </span>
                                    <span>
                                        @prompt.VisibleCommentCount
                                    </span>
                                </span>
                            </div>
                        </div>

                        <footer class="prompt-note-footer catalog-card-footer">
                            <div class="prompt-note-actions">
                                <a asp-controller="Prompts"
                                   asp-action="Details"
                                   asp-route-slug="@prompt.Slug"
                                   class="prompt-note-open">
                                    Открыть →
                                </a>
                            </div>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>
</section>
