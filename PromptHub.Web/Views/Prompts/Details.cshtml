                                       class="prompt-comment-author">
                                        @comment.AuthorName
                                    </a>

                                    <div class="prompt-comment-meta">
    <time datetime="@DateTime.SpecifyKind(comment.CreatedAtUtc, DateTimeKind.Utc).ToString("O")"
          data-local-datetime>
        @comment.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")
    </time>

    @if (comment.WasEdited)
    {
        <span>
            изменён
        </span>
    }

                                        @if (comment.IsHiddenByModerator)
                                        {
                                            <span class="prompt-comment-hidden-badge">
                                                скрыт
                                            </span>
                                        }
                                    </div>
                                </header>

                                @if (comment.IsHiddenByModerator)
                                {
                                    <div class="prompt-comment-moderation-note">
                                        Комментарий скрыт модератором.

                                        @if (!string.IsNullOrWhiteSpace(comment.ModerationReason))
                                        {
                                            <span>
                                                Причина: @comment.ModerationReason
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="prompt-comment-body">
                                    @comment.Body
                                </div>

                                @if (comment.CanDelete || comment.CanHide || comment.CanReport || comment.HasOpenReportByCurrentUser)
                                {
                                    <footer class="prompt-comment-actions">
                                        @if (comment.CanDelete)
                                        {
                                            <form asp-controller="PromptComments"
                                                  asp-action="DeleteComment"
                                                  asp-route-slug="@Model.Slug"
                                                  asp-route-commentId="@comment.CommentId"
                                                  method="post"
                                                  class="prompt-comment-action-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="prompt-comment-delete-button"
                                                        onclick="return confirm('Удалить комментарий?');">
                                                    Удалить
                                                </button>
                                            </form>
                                        }

                                        @if (comment.CanReport)
                                        {
                                            <details class="prompt-comment-report-details">
                                                <summary>
                                                    Пожаловаться
                                                </summary>

                                                <form asp-controller="PromptComments"
                                                      asp-action="ReportComment"
                                                      asp-route-slug="@Model.Slug"
                                                      asp-route-commentId="@comment.CommentId"
                                                      method="post"
                                                      class="prompt-comment-report-form">

                                                    @Html.AntiForgeryToken()

                                                    <div class="prompt-comment-report-grid">
                                                        <label class="visually-hidden"
                                                               for="commentReportReason-@comment.CommentId">
                                                            Причина жалобы
                                                        </label>

                                                        <select id="commentReportReason-@comment.CommentId"
                                                                name="reason"
                                                                class="form-select form-select-sm"
                                                                required>
                                                            <option value="Spam">
                                                                Спам или реклама
                                                            </option>

                                                            <option value="InsultOrHarassment">
                                                                Оскорбление или травля
                                                            </option>

                                                            <option value="HateOrExtremism">
                                                                Ненависть или экстремизм
                                                            </option>

                                                            <option value="PersonalData">
                                                                Личные данные
                                                            </option>

                                                            <option value="IllegalContent">
                                                                Запрещённый контент
                                                            </option>

                                                            <option value="OffTopic">
                                                                Не по теме
                                                            </option>

                                                            <option value="Other">
                                                                Другое
                                                            </option>
                                                        </select>

                                                        <label class="visually-hidden"
                                                               for="commentReportDetails-@comment.CommentId">
                                                            Подробности
                                                        </label>

                                                        <textarea id="commentReportDetails-@comment.CommentId"
                                                                  name="details"
                                                                  class="form-control form-control-sm"
                                                                  rows="2"
                                                                  maxlength="1000"
                                                                  placeholder="Подробности, если нужно"></textarea>

                                                        <button type="submit"
                                                                class="prompt-comment-report-button"
                                                                onclick="return confirm('Отправить жалобу на комментарий?');">
                                                            Отправить
                                                        </button>
                                                    </div>
                                                </form>
                                            </details>
                                        }

                                        @if (comment.HasOpenReportByCurrentUser)
                                        {
                                            <div class="prompt-comment-report-status">
                                                Жалоба уже отправлена.
                                            </div>
                                        }

                                        @if (comment.CanHide)
                                        {
                                            <details class="prompt-comment-moderation-details">
                                                <summary>
                                                    Модерация
                                                </summary>

                                                <form asp-controller="PromptComments"
                                                      asp-action="HideComment"
                                                      asp-route-slug="@Model.Slug"
                                                      asp-route-commentId="@comment.CommentId"
                                                      method="post"
                                                      class="prompt-comment-hide-form">

                                                    @Html.AntiForgeryToken()

                                                    <label class="visually-hidden"
                                                           for="moderationReason-@comment.CommentId">
                                                        Причина скрытия
                                                    </label>

                                                    <div class="prompt-comment-hide-row">
                                                        <input id="moderationReason-@comment.CommentId"
                                                               type="text"
                                                               name="moderationReason"
                                                               class="form-control form-control-sm"
                                                               maxlength="500"
                                                               required
                                                               placeholder="Причина скрытия" />

                                                        <button type="submit"
                                                                class="prompt-comment-hide-button"
                                                                onclick="return confirm('Скрыть комментарий?');">
                                                            Скрыть
                                                        </button>
                                                    </div>
                                                </form>
                                            </details>
                                        }
                                    </footer>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        }

    </main>

