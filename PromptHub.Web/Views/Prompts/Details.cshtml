                        </div>
                    </form>
                }
                else
                {
                    <div class="prompt-comment-login-note">
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}#comments")"
