                            Войдите
                        </a>,
                        чтобы оставить комментарий.
                    </div>
                }

                @if (Model.Comments.Count == 0)
                {
                    <div class="prompt-comments-empty">
                        Комментариев пока нет. Будьте первым, кто обсудит этот промпт.
                    </div>
