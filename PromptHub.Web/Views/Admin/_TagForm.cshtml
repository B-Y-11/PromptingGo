@model PromptHub.Web.Models.ViewModels.Admin.AdminTagEditorViewModel

<section class="admin-category-form-page">
    <main class="identity-sheet admin-category-form-sheet">
        <div class="identity-kicker">
            Теги каталога
        </div>

        <h1 class="identity-title">
            @Model.PageTitle
        </h1>

        <p class="identity-description">
            Тег помогает точнее описать назначение промпта:
            экзамен, перевод, код, резюме, конспект и т.д.
        </p>

        @if (Model.IsEditMode &&
             !string.IsNullOrWhiteSpace(Model.CurrentSlug))
        {
            <div class="admin-category-current-slug">
                Текущий адрес:
                <strong>
                    @Model.CurrentSlug
                </strong>

                <span>
                    Slug не меняется автоматически,
                    чтобы не ломать уже существующие ссылки.
                </span>
            </div>
        }

        <form method="post"
              class="identity-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="mb-4">
                <label asp-for="Input.Name"
                       class="form-label">
                </label>

                <input asp-for="Input.Name"
                       class="form-control"
                       placeholder="Например: экзамен" />

                <span asp-validation-for="Input.Name"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Description"
                       class="form-label">
                </label>

                <textarea asp-for="Input.Description"
                          class="form-control"
                          rows="4"
                          maxlength="400"
                          placeholder="Коротко опишите, для каких промптов подходит этот тег."></textarea>

                <span asp-validation-for="Input.Description"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.SortOrder"
                       class="form-label">
                </label>

                <input asp-for="Input.SortOrder"
                       class="form-control"
                       type="number" />

                <span asp-validation-for="Input.SortOrder"
                      class="text-danger">
                </span>
            </div>

            <div class="admin-category-active-row">
                <div class="form-check">
                    <input asp-for="Input.IsActive"
                           class="form-check-input" />

                    <label asp-for="Input.IsActive"
                           class="form-check-label">
                    </label>
                </div>

                <div class="form-text">
                    Если снять галочку, тег не будет доступен
                    при создании и редактировании промптов.
                </div>
            </div>

            <div class="account-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    @Model.SubmitButtonText
                </button>

                <a asp-controller="Admin"
                   asp-action="Tags"
                   class="btn btn-outline-secondary">
                    Назад к тегам
                </a>
            </div>
        </form>
    </main>
</section>

@section Scripts
{
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}