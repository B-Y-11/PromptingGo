@using PromptHub.Web.Extensions
@using PromptHub.Web.Models.Enums
@model PromptHub.Web.Models.ViewModels.Prompts.PromptMediaManagementViewModel

@{
    ViewData["Title"] = "Медиа промпта";
}

<section class="prompt-form-page">
    @* -------------------------------------------------------------------------
       EN: Media management header
       RU: Заголовок управления медиа
       ------------------------------------------------------------------------- *@

    <header class="prompt-form-header">
        <div class="prompt-form-kicker">
            Примеры результата
        </div>

        <h1 class="prompt-form-title">
            Медиа промпта
        </h1>

        <p class="prompt-form-description">
            @Model.PromptTitle
        </p>

        <div class="d-flex flex-wrap gap-2 mt-3">
            <span class="badge text-bg-secondary">
                @Model.PromptStatusName
            </span>

            <span class="badge text-bg-light border text-dark">
                Активных изображений:
                @Model.ActiveImageCount /
                @Model.MaxImagesPerPrompt
            </span>
        </div>
    </header>

    @if (TempData["SuccessMessage"]
        is string successMessage)
    {
        <div class="alert alert-success">
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"]
        is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @* -------------------------------------------------------------------------
       EN: Image upload form
       RU: Форма загрузки изображений
       ------------------------------------------------------------------------- *@

    <section class="prompt-form-sheet mb-4">
        <h2 class="prompt-form-section-title">
            Добавить изображения
        </h2>

        @if (Model.CanUpload &&
             Model.RemainingImageSlots > 0)
        {
            <p class="text-muted">
                Можно выбрать сразу несколько файлов.
                Доступно ещё:
                @Model.RemainingImageSlots.
            </p>

            @if (Model.PromptStatus ==
                 PromptStatus.Published)
            {
                <div class="alert alert-info">
                    Новые изображения не заменят текущую галерею сразу.
                    Сначала они пройдут отдельную модерацию.
                </div>
            }

            <form asp-controller="PromptMedia"
                  asp-action="Upload"
                  asp-route-promptId="@Model.PromptId"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="images"
                           class="form-label">
                        Изображения результата
                    </label>

                    <input id="images"
                           name="images"
                           type="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           multiple
                           required />

                    <div class="form-text">
                        JPG, PNG или WEBP.
                        До 5 МБ на один файл.
                        Не более @Model.MaxImagesPerPrompt
                        активных изображений на промпт.
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Загрузить изображения
                </button>
            </form>
        }
        else if (!Model.CanUpload)
        {
            <div class="alert alert-secondary mb-0">
                @Model.UploadBlockedReason
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-0">
                Достигнуто максимальное количество изображений.
                Чтобы добавить новое, сначала уберите старое из галереи.
            </div>
        }
    </section>

    @* -------------------------------------------------------------------------
       EN: Existing prompt media
       RU: Существующие медиа промпта
       ------------------------------------------------------------------------- *@

    <section class="prompt-form-sheet">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="prompt-form-section-title mb-0">
                Загруженные изображения
            </h2>

            <span class="text-muted">
                Всего записей: @Model.MediaItems.Count
            </span>
        </div>

        @if (Model.MediaItems.Count == 0)
        {
            <div class="author-empty-sheet">
                <h3>
                    Изображений пока нет
                </h3>

                <p>
                    Добавьте примеры результата,
                    полученного с помощью этого промпта.
                </p>
            </div>
        }
        else
        {
            @* -------------------------------------------------------------------------
               EN: Drag-and-drop active media ordering
               RU: Сортировка активных медиа перетаскиванием
               ------------------------------------------------------------------------- *@

            @if (Model.CanReorder)
            {
                var reorderableMedia =
                    Model.MediaItems
                        .Where(media =>
                            media.IsReorderable)
                        .OrderBy(media =>
                            media.SortOrder)
                        .ThenBy(media =>
                            media.CreatedAtUtc)
                        .ThenBy(media =>
                            media.Id)
                        .ToArray();

                <section class="prompt-media-order-sheet"
                         data-media-order-component>

                    <div class="prompt-media-order-header">
                        <div>
                            <h2 class="h4 mb-1">
                                Порядок изображений
                            </h2>

                            <p class="text-muted mb-0">
                                Перетащите изображения в нужном порядке,
                                затем сохраните изменения.
                            </p>
                        </div>

                        <span class="prompt-media-order-status"
                              data-media-order-status
                              aria-live="polite">
                            Изменений нет
                        </span>
                    </div>

                    <div class="prompt-media-order-list"
                         data-media-order-list>

                        @foreach (var media in reorderableMedia)
                        {
                            var thumbnailUrl =
                                Url.RouteUrl(
                                    "PromptMediaThumbnail",
                                    new
                                    {
                                        id = media.Id
                                    });

                            var thumbnailAltText =
                                string.IsNullOrWhiteSpace(
                                    media.AltText)
                                    ? $"Изображение {media.OriginalFileName}"
                                    : media.AltText;

                            <article class="prompt-media-order-item"
                                     draggable="true"
                                     data-media-order-item
                                     data-media-id="@media.Id">

                                <button type="button"
                                        class="prompt-media-order-handle"
                                        data-media-order-handle
                                        aria-label="Перетащить изображение «@media.OriginalFileName»">
                                    <span aria-hidden="true">
                                        ⋮⋮
                                    </span>
                                </button>

                                <div class="prompt-media-order-position"
                                     data-media-order-position
                                     aria-label="Позиция">
                                </div>

                                <img src="@thumbnailUrl"
                                     alt="@thumbnailAltText"
                                     class="prompt-media-order-image"
                                     loading="lazy"
                                     decoding="async" />

                                <div class="prompt-media-order-info">
                                    <strong class="prompt-media-order-name">
                                        @(string.IsNullOrWhiteSpace(
                                            media.Caption)
                                            ? media.OriginalFileName
                                            : media.Caption)
                                    </strong>

                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        <span class="badge @media.StatusBadgeClass">
                                            @media.StatusName
                                        </span>

                                        @if (media.IsCover)
                                        {
                                            <span class="badge text-bg-primary">
                                                Обложка
                                            </span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>

                    <form asp-controller="PromptMedia"
                          asp-action="Reorder"
                          asp-route-promptId="@Model.PromptId"
                          method="post"
                          class="prompt-media-order-actions"
                          data-media-order-form>

                        @Html.AntiForgeryToken()

                        <div data-media-order-inputs>
                            @foreach (var media in reorderableMedia)
                            {
                                <input type="hidden"
                                       name="OrderedMediaIds"
                                       value="@media.Id" />
                            }
                        </div>

                        <button type="submit"
                                class="btn btn-primary"
                                data-media-order-save
                                disabled>
                            Сохранить порядок
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-media-order-reset
                                disabled>
                            Отменить изменения
                        </button>
                    </form>

                    <p class="small text-muted mt-3 mb-0">
                        Кнопки «Выше» и «Ниже» в карточках ниже
                        продолжают работать без перетаскивания.
                    </p>
                </section>
            }
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var media in Model.MediaItems)
                {
                    var imageUrl =
                        Url.RouteUrl(
                            "PromptMediaThumbnail",
                            new
                            {
                                id = media.Id
                            });

                    <div class="col">
                        <article class="card h-100">
                            @* ---------------------------------------------------------------------
                               EN: Stored image preview or purged-file placeholder
                               RU: Предпросмотр изображения или заглушка удалённого файла
                               --------------------------------------------------------------------- *@

                            @if (media.HasStoredFile)
                            {
                                <img src="@imageUrl"
                                     alt="@(string.IsNullOrWhiteSpace(media.AltText)
                                             ? "Пример результата промпта"
                                             : media.AltText)"
                                     class="card-img-top"
                                     style="height: 240px; object-fit: contain; background: #f4f1e8;" />
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center
                                    text-center text-muted p-4"
                                     style="height: 240px; background: #f4f1e8;">

                                    <strong>
                                        Файл удалён из хранилища
                                    </strong>

                                    <span class="small mt-2">
                                        Запись сохранена для истории.
                                    </span>
                                </div>
                            }

                            <div class="card-body">
                                @* -----------------------------------------------------------------
                                   EN: Media status
                                   RU: Статус медиа
                                   ----------------------------------------------------------------- *@

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="badge @media.StatusBadgeClass">
                                        @media.StatusName
                                    </span>

                                    @if (media.IsCover)
                                    {
                                        <span class="badge text-bg-primary">
                                            Обложка
                                        </span>
                                    }

                                    @if (media.HasPendingMetadataReview)
                                    {
                                        <span class="badge text-bg-warning">
                                            Описание на модерации
                                        </span>
                                    }
                                </div>

                                <div class="small text-muted text-break">
                                    @media.OriginalFileName
                                </div>

                                <div class="small text-muted mt-1">
    Добавлено:

    <time datetime="@DateTime.SpecifyKind(media.CreatedAtUtc, DateTimeKind.Utc).ToString("O")"
          data-local-datetime>
        @media.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")
    </time>
</div>

                                @if (media.HasPendingMetadataReview &&
                                     media.Status ==
                                        PromptMediaStatus.Published)
                                {
                                    <div class="alert alert-info mt-3">
                                        Публичная подпись пока остаётся прежней.
                                        Новые значения появятся после проверки.
                                    </div>
                                }

                                @if (media.Status ==
                                        PromptMediaStatus.Rejected &&
                                     !string.IsNullOrWhiteSpace(
                                         media.ModerationComment))
                                {
                                    <div class="alert alert-danger mt-3">
                                        <strong>
                                            Причина отклонения изображения:
                                        </strong>

                                        <div>
                                            @media.ModerationComment
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                                    media.MetadataModerationComment))
                                {
                                    <div class="alert alert-danger mt-3">
                                        <strong>
                                            Причина отклонения описания:
                                        </strong>

                                        <div>
                                            @media.MetadataModerationComment
                                        </div>
                                    </div>
                                }

                                @if (media.StoragePurgedAtUtc.HasValue)
                                {
                                    <div class="alert alert-secondary mt-3">
                                        Физический файл удалён:

                                        <time datetime="@media.StoragePurgedAtUtc.Value.ToUtcIsoString()"
                                              data-local-datetime>
                                            @media.StoragePurgedAtUtc.Value.ToString("dd.MM.yyyy HH:mm")
                                        </time>
                                    </div>
                                }
                                else if (media.ScheduledPurgeAtUtc.HasValue)
                                {
                                    <div class="alert alert-warning mt-3">
                                        Файл будет автоматически удалён после:

                                        <time datetime="@media.ScheduledPurgeAtUtc.Value.ToUtcIsoString()"
                                              data-local-datetime>
                                            @media.ScheduledPurgeAtUtc.Value.ToString("dd.MM.yyyy HH:mm")
                                        </time>
                                    </div>
                                }

                                @* -----------------------------------------------------------------
                                   EN: Caption and alternative text form
                                   RU: Форма подписи и альтернативного текста
                                   ----------------------------------------------------------------- *@

                                @if (media.CanEditMetadata)
                                {
                                    <form asp-controller="PromptMedia"
                                          asp-action="UpdateMetadata"
                                          asp-route-promptId="@Model.PromptId"
                                          asp-route-mediaId="@media.Id"
                                          method="post"
                                          class="mt-3">

                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">
                                            <label for="caption-@media.Id"
                                                   class="form-label">
                                                Подпись
                                            </label>

                                            <textarea id="caption-@media.Id"
                                                      name="Caption"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="500"
                                                      placeholder="Кратко опишите полученный результат.">@media.EditableCaption</textarea>

                                            <div class="form-text">
                                                До 500 символов.
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="altText-@media.Id"
                                                   class="form-label">
                                                Alt-текст
                                            </label>

                                            <input id="altText-@media.Id"
                                                   name="AltText"
                                                   type="text"
                                                   class="form-control"
                                                   maxlength="300"
                                                   value="@media.EditableAltText"
                                                   placeholder="Опишите, что изображено на фотографии." />

                                            <div class="form-text">
                                                Alt-текст помогает пользователям
                                                программ экранного доступа.
                                            </div>
                                        </div>

                                        <button type="submit"
                                                class="btn btn-outline-primary btn-sm">
                                            @(media.Status ==
                                                PromptMediaStatus.Published
                                                ? "Отправить изменения"
                                                : "Сохранить описание")
                                        </button>
                                    </form>
                                }
                            </div>

                            @* ---------------------------------------------------------------------
                               EN: Ordering, cover and archive actions
                               RU: Действия порядка, обложки и архива
                               --------------------------------------------------------------------- *@

                            @if (media.CanMoveUp ||
                                 media.CanMoveDown ||
                                 media.CanSetCover ||
                                 media.CanArchive)
                            {
                                <div class="card-footer bg-transparent">
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (media.CanMoveUp)
                                        {
                                            <form asp-controller="PromptMedia"
                                                  asp-action="Move"
                                                  asp-route-promptId="@Model.PromptId"
                                                  asp-route-mediaId="@media.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="direction"
                                                       value="up" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm">
                                                    Выше
                                                </button>
                                            </form>
                                        }

                                        @if (media.CanMoveDown)
                                        {
                                            <form asp-controller="PromptMedia"
                                                  asp-action="Move"
                                                  asp-route-promptId="@Model.PromptId"
                                                  asp-route-mediaId="@media.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="direction"
                                                       value="down" />

                                                <button type="submit"
                                                        class="btn btn-outline-secondary btn-sm">
                                                    Ниже
                                                </button>
                                            </form>
                                        }

                                        @if (media.CanSetCover)
                                        {
                                            <form asp-controller="PromptMedia"
                                                  asp-action="SetCover"
                                                  asp-route-promptId="@Model.PromptId"
                                                  asp-route-mediaId="@media.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-primary btn-sm">
                                                    Сделать обложкой
                                                </button>
                                            </form>
                                        }

                                        @if (media.CanArchive)
                                        {
                                            <form asp-controller="PromptMedia"
                                                  asp-action="Archive"
                                                  asp-route-promptId="@Model.PromptId"
                                                  asp-route-mediaId="@media.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Убрать это изображение из галереи?');">
                                                    Убрать из галереи
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-controller="Prompts"
           asp-action="My"
           class="btn btn-outline-secondary">
            Вернуться к моим промптам
        </a>

        @if (Model.PromptStatus !=
             PromptStatus.Published)
        {
            <a asp-controller="Prompts"
               asp-action="Preview"
               asp-route-id="@Model.PromptId"
               class="btn btn-outline-primary">
                Открыть предпросмотр
            </a>
        }
    </div>
</section>

@section Scripts
{
    <script src="~/js/prompt-media-order.js"
            asp-append-version="true"></script>
}
