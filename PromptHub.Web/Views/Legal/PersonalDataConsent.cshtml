@using Microsoft.Extensions.Options
@using PromptHub.Web.Configuration
@inject IOptions<LegalOptions> LegalOptionsAccessor

@{
    ViewData["Title"] =
        "Согласие на обработку персональных данных";

    ViewData["Robots"] =
        "noindex,follow";

    var legal =
        LegalOptionsAccessor.Value;
}

<div class="container py-5">
    <article class="mx-auto"
             style="max-width: 900px;">

        <h1 class="mb-3">
            Согласие на обработку персональных данных
        </h1>

        <p class="text-muted">
            Редакция от 28 августа 2026 года
        </p>

        @if (!string.IsNullOrWhiteSpace(
                legal.OperatorName))
        {
            <p>
                Оператор персональных данных:
                <strong>@legal.OperatorName</strong>

                @if (!string.IsNullOrWhiteSpace(
                        legal.OperatorAddress))
                {
                    <span>
                        , адрес: @legal.OperatorAddress
                    </span>
                }
            </p>
        }

        <p>
            Создавая аккаунт PromptingGo
            и подтверждая настоящее согласие,
            пользователь свободно, своей волей
            и в своём интересе предоставляет
            согласие на обработку персональных данных,
            передаваемых сервису.
        </p>

        <h2 class="h4 mt-5">
            Персональные данные
        </h2>

        <p>
            Согласие распространяется
            на имя на сайте (псевдоним),
            адрес электронной почты,
            дату регистрации аккаунта,
            описание и изображение профиля, если они добавлены,
            сведения, содержащиеся в пользовательских материалах
            и действиях в сервисе, если они связаны с учетной записью
            пользователя, а также на технические данные, необходимые
            для аутентификации, защиты форм
            и обеспечения безопасности сервиса.
        </p>

        <h2 class="h4 mt-5">
            Публичные сведения профиля
        </h2>

        <p>
            Имя на сайте (псевдоним) и дата регистрации
            отображаются в публичном профиле. Описание и изображение
            профиля отображаются публично только если пользователь
            самостоятельно их добавил. Настоящее имя и личную
            фотографию указывать не требуется. Публичные сведения
            могут быть доступны неопределённому кругу лиц
            и индексироваться поисковыми системами.
        </p>

        <p>
            Адрес электронной почты не отображается
            в публичном профиле и не показывается другим пользователям.
        </p>

        <h2 class="h4 mt-5">
            Цели обработки
        </h2>

        <p>
            Обработка осуществляется для создания
            и обслуживания аккаунта,
            аутентификации,
            предоставления функций PromptingGo,
            формирования публичного профиля,
            взаимодействия с пользователем,
            модерации, обеспечения безопасности
            и исполнения Пользовательского соглашения.
        </p>

        <h2 class="h4 mt-5">
            Действия с данными
        </h2>

        <p>
            В рамках указанных целей могут осуществляться
            сбор, запись, систематизация,
            накопление, хранение, уточнение,
            извлечение, использование,
            предоставление техническим обработчикам
            в необходимом для соответствующей цели объёме,
            блокирование и удаление персональных данных.
        </p>

        <h2 class="h4 mt-5">
            Срок действия
        </h2>

        <p>
            Согласие действует до достижения целей
            обработки либо его отзыва,
            если дальнейшая обработка не требуется
            или не допускается на ином законном основании.
        </p>

        <h2 class="h4 mt-5">
            Отзыв согласия
        </h2>

        <p>
            Пользователь может отозвать согласие,
            направив обращение владельцу PromptingGo
            по контактам, указанным в

            <a asp-route="LegalPrivacy">
                Политике обработки персональных данных
            </a>.
        </p>

    </article>
</div>
