@using Microsoft.Extensions.Options
@using PromptHub.Web.Configuration
@inject IOptions<LegalOptions> LegalOptionsAccessor

@{
    ViewData["Title"] =
        "Политика обработки персональных данных";

    ViewData["Robots"] =
        "noindex,follow";

    var legal =
        LegalOptionsAccessor.Value;
}

<div class="container py-5">
    <article class="mx-auto"
             style="max-width: 900px;">

        <h1 class="mb-3">
            Политика обработки персональных данных
        </h1>

        <p class="text-muted">
            Редакция от 28 августа 2026 года
        </p>

        @if (!string.IsNullOrWhiteSpace(
                legal.OperatorName))
        {
            <p>
                Оператор персональных данных:
                <strong>@legal.OperatorName</strong>
            </p>

            @if (!string.IsNullOrWhiteSpace(
                    legal.OperatorAddress))
            {
                <p>
                    Адрес оператора:
                    @legal.OperatorAddress
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(
                    legal.ContactEmail))
            {
                <p>
                    Обращения по вопросам обработки
                    персональных данных:

                    <a href="mailto:@legal.ContactEmail">
                        @legal.ContactEmail
                    </a>
                </p>
            }
        }
        else if (!string.IsNullOrWhiteSpace(
                     legal.ContactEmail))
        {
            <p>
                Связаться с PromptingGo:

                <a href="mailto:@legal.ContactEmail">
                    @legal.ContactEmail
                </a>
            </p>
        }

        <h2 class="h4 mt-5">
            1. Общие положения
        </h2>

        <p>
            Настоящая Политика описывает обработку
            персональных данных пользователей
            сервиса PromptingGo,
            доступного по адресу promptinggo.ru.
        </p>


        <h2 class="h4 mt-5">
            2. Какие данные могут обрабатываться
        </h2>

        <p>
            В зависимости от используемых функций
            PromptingGo может обрабатывать:
        </p>

        <ul>
            <li>
                имя на сайте (псевдоним);
            </li>

            <li>
                адрес электронной почты;
            </li>

            <li>
                дата регистрации аккаунта;
            </li>

            <li>
                описание и изображение профиля,
                если пользователь самостоятельно их добавил;
            </li>

            <li>
                настройки добровольной поддержки автора,
                включая выбранный платёжный сервис
                и необходимый для него идентификатор
                страницы или кошелька;
            </li>

            <li>
                созданные пользователем промпты,
                комментарии, оценки, избранное,
                жалобы и иные действия в сервисе;
            </li>

            <li>
                сведения, необходимые
                для аутентификации
                и обеспечения безопасности аккаунта;
            </li>

            <li>
                технические данные запросов,
                включая IP-адрес, сведения о браузере,
                cookies и иные данные, необходимые
                для защиты форм, предотвращения
                автоматизированных запросов
                и стабильной работы сайта.
            </li>
        </ul>

        <h3 class="h5 mt-4">
            Публичный профиль
        </h3>

        <p>
            PromptingGo разделяет публичные и непубличные сведения аккаунта.
            Имя на сайте (псевдоним) и дата регистрации отображаются
            в публичном профиле. Описание и изображение профиля становятся
            публичными только в том случае, если пользователь сам их добавил.
        </p>

        <p>
            PromptingGo не требует указывать настоящее имя или загружать
            личную фотографию. Пользователь самостоятельно определяет
            содержание полей, предназначенных для публичного отображения.
            Публично размещённые сведения и материалы могут быть доступны
            неопределённому кругу лиц и индексироваться поисковыми системами.
        </p>

        <p>
            Адрес электронной почты не является частью публичного профиля
            и не отображается посетителям или другим пользователям.
            Доступ к нему может иметь оператор, а также уполномоченные
            администраторы и модераторы в объёме, необходимом для работы
            аккаунта, поддержки, модерации и обеспечения безопасности.
        </p>


        <h2 class="h4 mt-5">
            3. Для чего используются данные
        </h2>

        <p>
            Данные могут использоваться для:
        </p>

        <ul>
            <li>
                создания и обслуживания аккаунта;
            </li>

            <li>
                аутентификации пользователя;
            </li>

            <li>
                формирования и отображения публичного профиля,
                а также публикации материалов от имени автора;
            </li>

            <li>
                работы комментариев,
                рейтингов,
                избранного
                и уведомлений;
            </li>

            <li>
                модерации
                и рассмотрения жалоб;
            </li>

            <li>
                защиты сервиса
                от злоупотреблений;
            </li>

            <li>
                обеспечения работы сайта
                и устранения технических ошибок;
            </li>

            <li>
                формирования минимальной статистики
                использования PromptingGo;
            </li>

            <li>
                отображения подключённых автором
                способов добровольной поддержки.
            </li>
        </ul>


        <h2 class="h4 mt-5">
            4. Правовые основания обработки
        </h2>

        <p>
            В зависимости от цели обработка осуществляется
            на основании согласия пользователя, для заключения
            и исполнения Пользовательского соглашения,
            для осуществления прав и законных интересов оператора
            при условии, что не нарушаются права и свободы пользователя,
            а также в иных случаях, предусмотренных законодательством
            Российской Федерации.
        </p>

        <p>
            Необходимые технические данные, используемые для
            аутентификации, защиты аккаунтов, предотвращения атак
            и злоупотреблений, могут обрабатываться независимо
            от согласия на необязательные статистические cookie.
        </p>


        <h2 class="h4 mt-5">
            5. Cookies и статистика
        </h2>

        <p>
            PromptingGo использует необходимые cookie
            для авторизации,
            безопасности,
            защиты форм
            и сохранения пользовательских настроек.
        </p>

        <p>
            Дополнительная статистика просмотров
            и копирований промптов осуществляется
            только после соответствующего
            выбора пользователя.
        </p>

        <p>
            Для такой статистики может использоваться
            собственный случайный идентификатор посетителя.
            Исходное значение этого идентификатора
            не сохраняется в базе статистики.
        </p>

        <p>
            Пользователь может изменить свой выбор
            на странице

            <a href="@Url.RouteUrl("LegalCookies")">
                «Использование cookie»
            </a>.
        </p>


        <h2 class="h4 mt-5">
            6. Поддержка авторов и платёжные сервисы
        </h2>

        <p>
            Автор может самостоятельно подключить
            сторонние сервисы
            для получения добровольной поддержки,
            в том числе CloudTips и ЮMoney.
        </p>

        <p>
            PromptingGo хранит только данные,
            необходимые для отображения
            подключённого автором
            способа поддержки,
            например идентификатор страницы CloudTips
            или номер кошелька ЮMoney.
        </p>

        <p>
            Данные банковских карт,
            платёжные пароли
            и иные банковские реквизиты отправителя
            PromptingGo не запрашивает
            и не хранит.
        </p>

        <p>
            При использовании CloudTips
            пользователь переходит
            к взаимодействию
            со сторонним платёжным сервисом.
        </p>

        <p>
            При использовании ЮMoney
            браузер пользователя передаёт
            параметры перевода непосредственно
            сервису ЮMoney.
        </p>

        <p>
            В текущей реализации PromptingGo
            не получает информацию
            о факте, статусе
            или результате совершённого перевода.
        </p>

        <p>
            Последующая обработка данных
            сторонним платёжным сервисом
            осуществляется в соответствии
            с его собственными условиями
            и политикой конфиденциальности.
        </p>


        <h2 class="h4 mt-5">
            7. Передача данных
        </h2>

        <p>
            Для обеспечения работы отдельных функций
            данные могут обрабатываться организациями,
            предоставляющими инфраструктуру,
            хостинг, отправку электронной почты
            и другие технические услуги.
        </p>

        <p>
            Для доставки транзакционных писем,
            в том числе ссылок подтверждения email
            и восстановления доступа, PromptingGo
            использует сервис Unisender Go.
            В необходимом для доставки объёме
            ему передаются адрес электронной почты,
            содержание соответствующего письма
            и технические сведения об отправке и доставке.
            При включённых функциях статистики доставки
            также могут обрабатываться сведения
            об открытии письма и переходах по ссылкам.
        </p>

        <p>
            Для защиты публичных форм
            от автоматизированных запросов
            используется Yandex SmartCaptcha.
            При проверке могут обрабатываться
            технические сведения HTTP-запроса,
            включая IP-адрес, а также служебный
            токен проверки CAPTCHA.
        </p>

        <p>
            Передача осуществляется только
            в объёме, необходимом
            для соответствующей цели,
            либо в случаях,
            предусмотренных законом.
        </p>

        <p>
            В текущей конфигурации PromptingGo
            трансграничная передача персональных данных
            оператором не осуществляется.
        </p>


        <h2 class="h4 mt-5">
            8. Хранение
        </h2>

        <p>
            Основная база данных PromptingGo, содержащая персональные данные,
            размещается на серверной инфраструктуре в Российской Федерации.
        </p>

        <p>
            Персональные данные хранятся
            не дольше,
            чем этого требуют цели обработки,
            действующие отношения
            с пользователем
            либо законодательство.
        </p>

        <p>
            После прекращения необходимости обработки
            данные подлежат удалению,
            обезличиванию
            или иной предусмотренной законом обработке.
        </p>


        <h2 class="h4 mt-5">
            9. Безопасность
        </h2>

        <p>
            PromptingGo принимает организационные
            и технические меры
            для защиты данных
            от неправомерного доступа,
            изменения,
            раскрытия
            или уничтожения.
        </p>


        <h2 class="h4 mt-5">
            10. Права пользователя
        </h2>

        <p>
            Пользователь вправе запрашивать сведения
            об обработке своих персональных данных,
            требовать их уточнения,
            блокирования или удаления
            в случаях,
            предусмотренных законодательством.
        </p>

        <p>
            Пользователь также может
            отозвать ранее предоставленное согласие
            на обработку данных.
        </p>


        <h2 class="h4 mt-5">
            11. Контакты
        </h2>

        <p>
            Запросы, связанные с обработкой
            персональных данных,
            можно направить по адресу

            @if (!string.IsNullOrWhiteSpace(
                    legal.ContactEmail))
            {
                <a href="mailto:@legal.ContactEmail">
                    @legal.ContactEmail
                </a>
            }
            else
            {
                <span>
                    электронной почты,
                    который будет опубликован до запуска.
                </span>
            }
        </p>

    </article>
</div>
