@page
@model PromptHub.Web.Areas.Identity.Pages.Account.Manage.LinkPhoneVerifyModel

@{
    ViewData["Title"] = "Подтверждение телефона";
    Layout = "_ManageLayout";
}

<section class="account-content-sheet">
    <header class="account-section-header">
        <div>
            <div class="account-section-kicker">
                Безопасность
            </div>

            <h2>
                Подтвердите номер
            </h2>

            <p>
                Введите код, отправленный на
                @Model.MaskedPhoneNumber
            </p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <form method="post"
          class="account-profile-fields">

        <input asp-for="ChallengeId"
               type="hidden" />

        <div class="mb-4">
            <label asp-for="Input.Code"
                   class="form-label">
            </label>

            <input asp-for="Input.Code"
                   class="form-control"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   placeholder="123456" />

            <span asp-validation-for="Input.Code"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Подтвердить
        </button>

        <a asp-page="./LinkPhone"
           class="btn btn-outline-secondary">
            Запросить новый код
        </a>
    </form>
</section>

@section Scripts
{
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}