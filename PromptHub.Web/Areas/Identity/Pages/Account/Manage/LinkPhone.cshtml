@page
@model PromptHub.Web.Areas.Identity.Pages.Account.Manage.LinkPhoneModel

@{
    ViewData["Title"] = "Привязка телефона";
    Layout = "_ManageLayout";
}

<section class="account-content-sheet">
    <header class="account-section-header">
        <div>
            <div class="account-section-kicker">
                Безопасность
            </div>

            <h2>
                Привязать номер телефона
            </h2>

            <p>
                После подтверждения номера вы сможете использовать его
                для входа без пароля.
            </p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <form method="post"
          class="account-profile-fields">

        <div class="mb-4">
            <label asp-for="Input.CurrentPassword"
                   class="form-label">
            </label>

            <input asp-for="Input.CurrentPassword"
                   class="form-control"
                   autocomplete="current-password" />

            <span asp-validation-for="Input.CurrentPassword"
                  class="text-danger">
            </span>

            <div class="form-text">
                Повторная проверка пароля защищает изменение
                способов входа в аккаунт.
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Input.PhoneNumber"
                   class="form-label">
            </label>

            <input asp-for="Input.PhoneNumber"
                   class="form-control"
                   type="tel"
                   autocomplete="tel"
                   inputmode="tel"
                   placeholder="+7 999 123-45-67" />

            <span asp-validation-for="Input.PhoneNumber"
                  class="text-danger">
            </span>

            <div class="form-text">
                Используйте международный формат.
            </div>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Получить код
        </button>

        <a asp-page="./SignInMethods"
           class="btn btn-outline-secondary">
            Отмена
        </a>
    </form>
</section>

@section Scripts
{
    <partial name="/Views/Shared/_ValidationScriptsPartial.cshtml" />
}