@page
@model PromptHub.Web.Areas.Identity.Pages.Account.Manage.SignInMethodsModel
@using Microsoft.Extensions.Options
@using PromptHub.Web.Services.Identity
@inject IOptions<PhoneAuthenticationFeatureOptions> PhoneAuthenticationOptions

@{
    ViewData["Title"] = "Способы входа";
    Layout = "_ManageLayout";
}

<section class="account-content-sheet">
    <header class="account-section-header">
        <div>
            <div class="account-section-kicker">
                Страница 03
            </div>

            <h2>
                Способы входа
            </h2>

            <p>
                Управляйте способами, которыми можно войти в ваш аккаунт.
            </p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(
        Model.StatusMessage))
    {
        <div class="alert alert-success">
            @Model.StatusMessage
        </div>
    }

    <div class="account-profile-fields">

        <div class="mb-4">
            <label class="form-label">
                Email
            </label>

            @if (!string.IsNullOrWhiteSpace(
                Model.Email))
            {
                <input class="form-control"
                       value="@Model.Email"
                       disabled />

                <div class="form-text">
                    @(Model.EmailConfirmed
                        ? "Email подтверждён."
                        : "Email не подтверждён.")
                </div>
            }
            else
            {
                <input class="form-control"
                       value="Не указан"
                       disabled />
            }
        </div>

        @if (PhoneAuthenticationOptions.Value.Enabled)
        {
            <div class="mb-4">
                <label class="form-label">
                    Телефон
                </label>
    
                @if (Model.HasPhoneNumber)
                {
                    <input class="form-control"
                           value="@Model.MaskedPhoneNumber"
                           disabled />
    
                    <div class="form-text">
                        Номер подтверждён и может использоваться для входа.
                    </div>
    
                    <div class="mt-3">
                        <a asp-page="./ChangePhone"
                           class="btn btn-outline-secondary btn-sm">
                            Сменить номер
                        </a>
                    </div>
                }
                else
                {
                    <input class="form-control"
                           value="Не привязан"
                           disabled />
    
                    <div class="mt-3">
                        <a asp-page="./LinkPhone"
                           class="btn btn-primary btn-sm">
                            Привязать номер
                        </a>
                    </div>
                }
            </div>
        }

        <div class="mb-4">
            <label class="form-label">
                Пароль
            </label>

            <input class="form-control"
                   value="@(Model.HasPassword
                                   ? "Установлен"
                                   : "Не установлен")"
                   disabled />
        </div>

        @if (PhoneAuthenticationOptions.Value.Enabled &&
             Model.HasPhoneNumber &&
             string.IsNullOrWhiteSpace(Model.Email) &&
             !Model.HasPassword)
        {
            <div class="mt-4">
                <a asp-page="./AddEmailPassword"
                   class="btn btn-primary">
                    Добавить email и пароль
                </a>

                <div class="form-text mt-2">
                    После этого у аккаунта будет дополнительный способ входа
                    и восстановления доступа.
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Email) &&
     !Model.EmailConfirmed)
        {
            <div class="mt-2">
                <a asp-area="Identity"
                   asp-page="/Account/ResendEmailConfirmation"
                   class="btn btn-outline-secondary btn-sm">
                    Отправить подтверждение повторно
                </a>
            </div>
        }

    </div>
</section>