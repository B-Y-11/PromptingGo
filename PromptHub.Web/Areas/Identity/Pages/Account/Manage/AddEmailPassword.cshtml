@page
@model PromptHub.Web.Areas.Identity.Pages.Account.Manage.AddEmailPasswordModel

@{
    ViewData["Title"] = "Добавление email и пароля";
    Layout = "_ManageLayout";
}

<section class="account-content-sheet">
    <header class="account-section-header">
        <div>
            <div class="account-section-kicker">
                Безопасность
            </div>

            <h2>
                Добавить email и пароль
            </h2>

            <p>
                После настройки вы сможете входить как по телефону,
                так и по email и паролю.
            </p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="account-profile-fields">
        <div class="mb-4">
            <label class="form-label">
                Подтверждение личности
            </label>

            <div class="form-text">
                Мы отправим одноразовый код на ваш подтверждённый номер
                @Model.MaskedPhoneNumber.
            </div>
        </div>

        <form method="post">
            <button type="submit"
                    class="btn btn-primary">
                Получить код
            </button>

            <a asp-page="./SignInMethods"
               class="btn btn-outline-secondary">
                Отмена
            </a>
        </form>
    </div>
</section>