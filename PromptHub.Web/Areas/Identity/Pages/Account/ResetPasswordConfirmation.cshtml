@page
@model PromptHub.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Пароль изменён";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="identity-page">
    <div class="identity-layout">
        <main class="identity-sheet">
            <div class="identity-kicker">
                Доступ восстановлен
            </div>

            <h1 class="identity-title">
                Пароль изменён
            </h1>

            <div class="alert alert-success">
                Новый пароль успешно сохранён.
            </div>

            <p class="identity-description">
                Теперь вы можете войти в PromptingGo,
                используя новый пароль.
            </p>

            <a asp-page="./Login"
               class="btn btn-primary identity-submit-button">
                Войти
            </a>
        </main>
    </div>
</section>
