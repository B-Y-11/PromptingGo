@page
@model PromptHub.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel

@{
    ViewData["Title"] = "Проверьте почту";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="identity-page">
    <div class="identity-layout">
        <main class="identity-sheet">
            <div class="identity-kicker">
                Запрос принят
            </div>

            <h1 class="identity-title">
                Проверьте почту
            </h1>

            <p class="identity-description">
                Если аккаунт с таким email существует,
                на него будет отправлена ссылка
                для восстановления пароля.
            </p>

            <div class="identity-password-note">
                Письмо может прийти не сразу.
                Также проверьте папку «Спам».
            </div>

            <a asp-page="./Login"
               class="btn btn-primary identity-submit-button">
                Вернуться ко входу
            </a>
        </main>
    </div>
</section>