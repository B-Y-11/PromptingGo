{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=prompthub;Username=prompthub;Password=change-me"
  },
  "MediaStorage": {
    "RootFolder": "App_Data/prompt-media",
    "MaxImageSizeBytes": 5242880,
    "MaxImagesPerPrompt": 6,
    "AvatarRootFolder": "App_Data/profile-avatars",
    "MaxAvatarImageSizeBytes": 2097152,
    "AvatarMaxWidth": 512,
    "AvatarMaxHeight": 512,
    "AvatarWebpQuality": 85,
    "MaxImageWidth": 12000,
    "MaxImageHeight": 12000,
    "MaxImagePixelCount": 40000000,
    "ThumbnailMaxWidth": 960,
    "ThumbnailMaxHeight": 720,
    "ThumbnailWebpQuality": 82,
    "AllowedImageContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp"
    ],
    "AllowedImageExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp"
    ]
  },
  "PromptMediaCleanup": {
    "ArchivedRetentionDays": 30,
    "RejectedRetentionDays": 30,
    "BatchSize": 100,
    "OrphanSafetyWindowHours": 24
  },
  "PhoneOtp": {
    "LifetimeMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxRequestsPerHour": 5,
    "MaxRequestsPerUserPerHour": 10,
    "MaxVerificationAttempts": 5,
    "RetentionHours": 24,
    "CleanupIntervalMinutes": 60
  },
  "Features": {
    "PhoneAuthentication": {
      "Enabled": false
    }
  },
  "UnisenderGo": {
    "ApiKey": "",
    "FromEmail": "noreply@example.com",
    "FromName": "PromptingGo",
    "BaseUrl": "https://goapi.unisender.ru/ru/transactional/api/v1/",
    "RequestTimeoutSeconds": 10,
    "DisableTracking": false,
    "SkipUnsubscribeBlock": false
  },
  "SmartCaptcha": {
    "Enabled": false,
    "ClientKey": "",
    "ServerKey": "",
    "ValidationEndpoint": "https://smartcaptcha.cloud.yandex.ru/validate",
    "RequestTimeoutSeconds": 2
  },
  "PromptMetricCleanup": {
    "RetentionDays": 7,
    "CleanupIntervalHours": 6
  },
  "Legal": {
    "OperatorName": "",
    "OperatorAddress": "",
    "ContactEmail": "support@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
