# Local development database. Use a unique password for your own environment.
POSTGRES_DB=prompthub
POSTGRES_USER=prompthub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
WEB_PORT=8080

# Optional: promote an already registered local account after restarting the app.
# Leave empty to avoid granting an administrator role automatically.
DEVELOPMENT_ADMIN_EMAIL=

# The local Compose web service runs in Development and does not send email.
# Configure real values outside source control before a separate production setup.
UNISENDER_GO_API_KEY=
UNISENDER_GO_FROM_EMAIL=noreply@example.com
SMARTCAPTCHA_ENABLED=false
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
LEGAL_CONTACT_EMAIL=support@example.com
